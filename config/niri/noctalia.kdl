layout {

    focus-ring {
        active-color   "#81d3de"
        inactive-color "#0e1415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#81d3de"
        inactive-color "#0e1415"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#81d3de"
        inactive-color "#004f56"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#81d3de80"
    }
}

recent-windows {
    highlight {
        active-color "#81d3de"
        urgent-color "#ffb4ab"
    }
}

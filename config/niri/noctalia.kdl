layout {

    focus-ring {
        active-color   "#d0bcfe"
        inactive-color "#141218"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d0bcfe"
        inactive-color "#141218"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d0bcfe"
        inactive-color "#4d3d75"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d0bcfe80"
    }
}

recent-windows {
    highlight {
        active-color "#d0bcfe"
        urgent-color "#ffb4ab"
    }
}
